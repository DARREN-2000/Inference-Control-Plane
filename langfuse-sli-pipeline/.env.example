# Copy to .env and fill in. The default install is dependency-free; only the
# DynamoDB checkpoint store needs boto3 + AWS credentials.

# --- Langfuse source (required for --source langfuse) ---
# LANGFUSE_BASE_URL is accepted as an alias. LANGFUSE_HOST takes precedence.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Resource identity stamped on emitted metrics ---
OTEL_DEPLOYMENT_ENVIRONMENT=prod

# --- Collector endpoint (for --emit otlp-http) ---
# Used as the default for --otlp-endpoint. Docker Compose overrides this for its
# local collector; production points it at the shared collector service.
OTLP_ENDPOINT=http://localhost:4318

# --- Durable checkpoint store (optional; enables cross-run watermark) ---
# Provide the DynamoDB table name to --checkpoint-dynamo-table and set the region.
# CHECKPOINT_DYNAMO_TABLE=gateway-sli-checkpoints
# CHECKPOINT_JOB_ID=gateway-sli
# AWS_REGION=eu-central-1
